# CivicPulse environment variables. Copy to .env.local for local dev, and set the
# same values in the Vercel dashboard for production. Never commit real values.

# --- Gemini (Google AI Studio, free tier) — SERVER-SIDE ONLY ---
GEMINI_API_KEY=

# --- Supabase (Project Settings → API) ---
# Public: safe in the browser bundle (RLS is on with no policies, so this key
# cannot read or write any table directly).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET: server-only. Bypasses RLS — never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for issue/proof photos (create it as PRIVATE).
SUPABASE_BUCKET=media
